pipeline {
    agent any 
    tool{
        maven "maven3.9"
        jdk "jdk17"
    }

    environment {
        
        image_name = '577811233724.dkr.ecr.us-east-1.amazonaws.com/nginx-app:latest'
        registry_url = 'https://577811233724.dkr.ecr.us-east-1.amazonaws.com/nginx-app'
    }

    stages  {
        stage('Checkout Source'){
            steps {
            git branch: 'main', url: ' '
            }
        }   
        stage ("build the code"){
            steps {
                sh 'mvn install -DskipTests'
            }
            post{
                echo "archive the artifacts"
                archiveArtifacts artifacts: '**/target/*.war'
            }
        }
        stage ('unit test'){
            steps {
                sh 'mvn test'
            }
        }
        stage ('Build Docker Image'){
            steps {
                script {
                    dockerImage = docker.build($image_name + "$BUILD_NUMBER",".dockerfile")
                }
            }
        }
        stage ('Push Docker Image to ECR'){
            steps {
                script {
                    docker.withRegistry( $registry_url , 'ecr:us-east-1:aws-credentials') {
                        dockerImage.push("$BUILD_NUMBER")
                        dockerImage.push("latest")
                    }
                }
            }

        }
        stage ('Remove Unused Docker Images'){
            steps {
                sh 'docker rmi -f $(docker images -a -q)'
            }
        }

}
}