pipeline {
    agent any
    tools {
        maven "Maven3.9"
        jdk "JDK17"
    }

    environment {
        image_name = '577811233724.dkr.ecr.us-east-1.amazonaws.com/dockerimg'
        registry_url = 'https://577811233724.dkr.ecr.us-east-1.amazonaws.com/dockerimg'
        AWS_REGION = "us-east-1" 
        CLUSTER_NAME = "my-eks-cluster"
    }

    stages {
        stage('Checkout Source') {
            steps {
                git branch: 'main', url: 'https://github.com/Shiwam123-git/NewDeploy.git'
            }
        }
        
       stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${image_name}:${BUILD_NUMBER}", "./nginx")
                }
            }
        }
        stage('Login to ECR') {
             steps {
             sh '''
        aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 577811233724.dkr.ecr.us-east-1.amazonaws.com
        '''
            }
    }


        stage('Push Docker Image to ECR') {
            steps {
                script {
                    docker.withRegistry("${registry_url}") {
                        dockerImage.push("${BUILD_NUMBER}")
                        dockerImage.push("latest")
                    }
                }
            }
        }

        stage('Remove Docker Image') {
            steps {
                sh "docker rmi -f ${image_name}:${BUILD_NUMBER}"
            }
        }
        stage('Update kubeconfig') {
             steps {
                 sh ''' aws eks --region ${AWS_REGION} update-kubeconfig --name ${CLUSTER_NAME} ''' 
                 } 
                }
        stage('Deploy to EKS') { 
            steps { sh ''' sed -i "s|IMAGE_PLACEHOLDER|${ECR_REPO}:${IMAGE_TAG}|g" deployment.yaml 
            kubectl apply -f deployment.yaml 
            kubectl apply -f service.yaml '''
             } 
        }
      
    }

}
