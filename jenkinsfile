pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        CLUSTER_NAME = "my-eks-cluster"
        ECR_REPO = "577811233724.dkr.ecr.us-east-1.amazonaws.com/dockerimg"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'main', url: 'https://github.com/Shiwam123-git/NewDeploy.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${ECR_REPO}:${IMAGE_TAG}", "./nginx")
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-1 \
                | docker login --username AWS --password-stdin 577811233724.dkr.ecr.us-east-1.amazonaws.com
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                script {
                    dockerImage.push("${IMAGE_TAG}")
                    dockerImage.push("latest")
                }
            }
        }

        stage('Update kubeconfig') {
            steps {
                sh '''
                aws eks --region ${AWS_REGION} update-kubeconfig --name ${CLUSTER_NAME}
                '''
            }
        }

        stage('Deploy Service (LoadBalancer)') {
            steps {
                sh '''
                cd yaml
                kubectl apply -f service.yaml
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                kubectl set image deployment/nginx-deployment \
                nginx-container=${ECR_REPO}:${IMAGE_TAG}

                kubectl rollout status deployment/nginx-deployment
                '''
            }
        }
    }
}
