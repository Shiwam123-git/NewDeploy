pipeline {
    agent any

    environment {
        AWS_REGION   = "us-east-1"
        CLUSTER_NAME = "my-eks-cluster"

        FRONTEND_REPO = "577811233724.dkr.ecr.us-east-1.amazonaws.com/dockerimg"
        BACKEND_REPO  = "577811233724.dkr.ecr.us-east-1.amazonaws.com/backend"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Shiwam123-git/NewDeploy.git'
            }
        }

        /* -------------------- LOGIN TO ECR -------------------- */
        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_REGION} \
                | docker login --username AWS --password-stdin 577811233724.dkr.ecr.us-east-1.amazonaws.com
                '''
            }
        }

        /* -------------------- BUILD BACKEND -------------------- */
        stage('Build Backend Image') {
              steps {
                sh 'ls -l ./nginx2.0/backend' // Debug
               script {
                   backendImage = docker.build(
                     "${BACKEND_REPO}:${IMAGE_TAG}",
                          "./nginx2.0/backend"
                )
               }
          }
      }


        stage('Push Backend Image') {
            steps {
                script {
                    backendImage.push("${IMAGE_TAG}")
                    backendImage.push("backend:latest")
                }
            }
        }

        /* -------------------- BUILD FRONTEND -------------------- */
        stage('Build Frontend Image') {
            steps {
                script {
                    frontendImage = docker.build(
                        "${FRONTEND_REPO}:${IMAGE_TAG}",
                        "./nginx2.0"
                    )
                }
            }
        }

        stage('Push Frontend Image') {
            steps {
                script {
                    frontendImage.push("${IMAGE_TAG}")
                    frontendImage.push("fortend:latest")
                }
            }
        }

        /* -------------------- KUBECONFIG -------------------- */
        stage('Update kubeconfig') {
            steps {
                sh '''
                aws eks --region ${AWS_REGION} update-kubeconfig --name ${CLUSTER_NAME}
                '''
            }
        }

        /* -------------------- DB SECRET -------------------- */
        stage('Deploy DB Secret') {
            steps {
                sh '''
                kubectl apply -f yaml/postgres-secret.yaml
                '''
            }
        }

        /* -------------------- DEPLOY BACKEND -------------------- */
        stage('Deploy Backend') {
            steps {
                sh '''
                kubectl apply -f nginx2.0/backend/backend-deployment.yaml
                kubectl apply -f nginx2.0/backend/backend-service.yaml

                kubectl set image deployment/backend-deployment \
                  backend-container=${BACKEND_REPO}:${IMAGE_TAG}

                kubectl rollout status deployment/backend-deployment
                '''
            }
        }

        /* -------------------- DEPLOY FRONTEND -------------------- */
        stage('Deploy Frontend Service') {
            steps {
                sh '''
                kubectl apply -f yaml/service-nginx.yaml
                '''
            }
        }

        stage('Deploy Frontend Deployment') {
            steps {
                sh '''
                kubectl apply -f yaml/deployment.yaml

                kubectl set image deployment/nginx-deployment \
                  nginx-container=${FRONTEND_REPO}:${IMAGE_TAG}

                kubectl rollout status deployment/nginx-deployment
                '''
            }
        }
    }

    post {
        success {
            echo "Backend + Frontend deployed successfully!"
        }
        failure {
            echo " Pipeline failed. Check logs."
        }
    }
}
